# ==============================================================================
# QUICK MART STORE BACKEND CONFIGURATION & HOW TO RUN GUIDE
# ==============================================================================

NODE_ENV=development
PORT=5000

# Example MongoDB Atlas URI:
# MONGO_URI=mongodb+srv://prem_user:mypassword123@cluster0.abcde.mongodb.net/emart?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/emart?retryWrites=true&w=majority

JWT_SECRET=emart_jwt_secret_key_987654321_secure
